{
  "name": "raglab-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "E2E tests for RAG Lab using Playwright",
  "devDependencies": {
    "@axe-core/playwright": "^4.9.0",
    "@playwright/test": "^1.48.2"
  },
  "scripts": {
    "test": "playwright test",
    "test:headed": "PW_HEADLESS=0 playwright test",
    "test:debug": "PW_HEADLESS=0 playwright test --debug",
    "report": "playwright show-report",
    "codegen": "playwright codegen"
  }
}
