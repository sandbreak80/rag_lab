{
  "title": "RAG Lab - Comprehensive System Overview",
  "uid": "rag-lab-overview",
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "10s",
  "tags": [
    "rag-lab",
    "monitoring",
    "system",
    "gpu"
  ],
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "type": "stat",
      "title": "Docker Container Status - All Containers",
      "description": "Shows up (1) or down (0) status for all Docker containers",
      "targets": [
        {
          "expr": "(time() - container_last_seen{name=~\"rag-.*\"}) < 60",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "value": "1",
              "text": "UP"
            },
            {
              "type": "value",
              "value": "0",
              "text": "DOWN"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": 0,
                "color": "red"
              },
              {
                "value": 1,
                "color": "green"
              }
            ]
          },
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 22,
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "type": "stat",
      "title": "RAG Pipeline Metrics",
      "description": "Real-time statistics from ChromaDB and Knowledge Graph",
      "targets": [
        {
          "expr": "vector_db_total_chunks",
          "legendFormat": "Chunks",
          "refId": "A"
        },
        {
          "expr": "vector_db_unique_files",
          "legendFormat": "Documents",
          "refId": "B"
        },
        {
          "expr": "graph_service_graph_nodes",
          "legendFormat": "Graph Nodes",
          "refId": "C"
        },
        {
          "expr": "graph_service_graph_edges",
          "legendFormat": "Graph Edges",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": 0,
                "color": "blue"
              },
              {
                "value": 100,
                "color": "green"
              },
              {
                "value": 1000,
                "color": "yellow"
              }
            ]
          },
          "decimals": 0
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center"
      }
    },
    {
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 16
      },
      "type": "graph",
      "title": "EC2 Host CPU Usage %",
      "targets": [
        {
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "CPU Usage",
          "refId": "A"
        }
      ],
      "yaxes": [
        {
          "format": "percent",
          "label": "CPU %",
          "min": 0,
          "max": 100
        },
        {
          "format": "short"
        }
      ],
      "lines": true,
      "linewidth": 2,
      "fill": 2,
      "fillGradient": 5
    },
    {
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 16
      },
      "type": "graph",
      "title": "EC2 Host Memory Usage",
      "targets": [
        {
          "expr": "(node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes) / 1024 / 1024 / 1024",
          "legendFormat": "Used",
          "refId": "A"
        },
        {
          "expr": "node_memory_MemAvailable_bytes / 1024 / 1024 / 1024",
          "legendFormat": "Available",
          "refId": "B"
        }
      ],
      "yaxes": [
        {
          "format": "gbytes",
          "label": "Memory (GB)"
        },
        {
          "format": "short"
        }
      ],
      "lines": true,
      "linewidth": 2,
      "fill": 1,
      "stack": true
    },
    {
      "id": 4,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 16
      },
      "type": "graph",
      "title": "EC2 Host Disk Usage %",
      "targets": [
        {
          "expr": "100 - ((node_filesystem_avail_bytes{mountpoint=\"/\",fstype!=\"tmpfs\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!=\"tmpfs\"}) * 100)",
          "legendFormat": "Root Disk",
          "refId": "A"
        }
      ],
      "yaxes": [
        {
          "format": "percent",
          "label": "Disk %",
          "min": 0,
          "max": 100
        },
        {
          "format": "short"
        }
      ],
      "lines": true,
      "linewidth": 2,
      "fill": 2,
      "fillGradient": 5
    },
    {
