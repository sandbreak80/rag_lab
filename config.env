# Neural Vault RAG Lab - Environment Configuration
# Copy this to .env for production use

# ============================================================================
# SERVICE DISCOVERY - Internal Docker Network URLs
# ============================================================================

# Core Services
VECTOR_DB_URL=http://vector-db:8005
SEARCH_SERVICE_URL=http://search-service:8002
CHAT_SERVICE_URL=http://chat-service:8003
EMBEDDING_SERVICE_URL=http://embedding-service:8006
INGEST_SERVICE_URL=http://ingest-service:8001
DOCLING_SERVICE_URL=http://docling-service:8004

# Enhanced Services
KNOWLEDGE_GRAPH_URL=http://knowledge-graph:8007
RERANKER_SERVICE_URL=http://reranker:8008
WEB_SEARCH_URL=http://web-search:8009
ENTITY_EXTRACTION_URL=http://entity-extraction:8010
METRICS_STORE_URL=http://metrics-store:8011

# Ollama Service (Internal Docker Network)
OLLAMA_BASE_URL=http://ollama:11434
LLM_SERVICE_URL=http://ollama:11434

# SearXNG
SEARXNG_BASE_URL=http://searxng:8080

# ============================================================================
# SERVICE PORTS
# ============================================================================

API_GATEWAY_PORT=8000
INGEST_SERVICE_PORT=8001
SEARCH_SERVICE_PORT=8002
CHAT_SERVICE_PORT=8003
DOCLING_SERVICE_PORT=8004
VECTOR_DB_PORT=8005
EMBEDDING_SERVICE_PORT=8006
KNOWLEDGE_GRAPH_PORT=8007
RERANKER_SERVICE_PORT=8008
WEB_SEARCH_PORT=8009
ENTITY_EXTRACTION_PORT=8010
METRICS_STORE_PORT=8011

# UI Ports
REACT_DEV_PORT=5173
PRODUCTION_UI_PORT=3000
OLD_UI_PORT=5555

# ============================================================================
# DATA PATHS - Docker Volume Mount Points
# ============================================================================

CHROMA_DB_PATH=/chroma/chroma
UPLOAD_FOLDER=/uploads
BM25_INDEX_PATH=/indices
KNOWLEDGE_GRAPH_PATH=/kg-data/knowledge_graph.pkl
METRICS_DB_PATH=/data/metrics/metrics.db

# ============================================================================
# LLM CONFIGURATION
# ============================================================================

# Chat Model - Upgraded for 16GB GPU
# Options: llama3.2:3b (2GB), llama3.1:8b (4.7GB), gemma2:9b (5.5GB), qwen2.5:14b (9GB)
CHAT_MODEL=llama3.1:8b

# Embedding Model - Reliable, proven model
# Options: nomic-embed-text (274M), mxbai-embed-large (335M), all-minilm (23M)
# Note: mxbai-embed-large may cause 500 errors, use nomic-embed-text for stability
EMBEDDING_MODEL=nomic-embed-text

DEFAULT_TEMPERATURE=0.7
DEFAULT_TOP_K=5

# Context Window - Increased for 8B model (supports up to 128K)
DEFAULT_CONTEXT_WINDOW=32768

# ============================================================================
# RAG DEFAULTS
# ============================================================================

DEFAULT_SEARCH_MODE=hybrid
USE_AGENTIC_CHUNKING=true
CHUNK_SIZE=800
CHUNK_OVERLAP=200
DEFAULT_SEARCH_LIMIT=10

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

COLLECTION_NAME=markdown_vault

# ============================================================================
# MONITORING & LOGGING
# ============================================================================

LOG_LEVEL=INFO
ENABLE_METRICS=true
ENABLE_TRACING=false
PYTHONUNBUFFERED=1

# ============================================================================
# SECURITY
# ============================================================================

CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5555

# ============================================================================
# PERFORMANCE TUNING
# ============================================================================

# Request timeouts (seconds)
DEFAULT_TIMEOUT=30
SEARCH_TIMEOUT=60
LLM_TIMEOUT=300
INGEST_TIMEOUT=600

# Retry configuration
MAX_RETRIES=3
RETRY_DELAY=2

# ============================================================================
# FEATURE FLAGS
# ============================================================================

ENABLE_QUERY_EXPANSION=true
ENABLE_BM25=true
ENABLE_HYBRID_SEARCH=true
ENABLE_KNOWLEDGE_GRAPH=true
ENABLE_RERANKING=false
ENABLE_WEB_SEARCH=true
ENABLE_AGENTIC_CHUNKING=true
ENABLE_ENTITY_EXTRACTION=true

# ============================================================================
# LAB-SPECIFIC SETTINGS
# ============================================================================

LAB_MODE=true
ENABLE_COMPARISON_MODE=true
STORE_QUERY_METRICS=true
ENABLE_PERFORMANCE_TRACKING=true

